<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Clean URLs for legal pages
  RewriteRule ^privacy-policy/?$ privacy-policy.html [L]
  RewriteRule ^terms-of-service/?$ terms-of-service.html [L]
  RewriteRule ^fabbrica/?$ fabbrica.html [L]
  # Serve Fabbrica page on fabbrica.rucept.com subdomain
  RewriteCond %{HTTP_HOST} ^fabbrica\.rucept\.com$ [NC]
  RewriteRule ^$ fabbrica.html [L]
  # php -- BEGIN cPanel-generated handler, do not edit
  # Set the "ea-php81" package as the default "PHP" programming language.
  <IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
  # php -- END cPanel-generated handler, do not edit
