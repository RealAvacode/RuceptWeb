<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # Retired subdomain: fabbrica.rucept.com sends every path to the same path on artefice.rucept.com
  RewriteCond %{HTTP_HOST} ^fabbrica\.rucept\.com$ [NC]
  RewriteRule ^(.*)$ https://artefice.rucept.com/$1 [L,R=301]
  # Apex + www: only the front page (root / index fall-through) moves to artefice.rucept.com; subpaths serve here as before
  RewriteCond %{HTTP_HOST} ^(www\.)?rucept\.com$ [NC]
  RewriteRule ^(index\.php)?$ https://artefice.rucept.com/ [L,R=301]
  # The /fabbrica path retires on the serving hosts: send it to the artefice front page
  RewriteCond %{HTTP_HOST} ^(artefice|artifice)\.rucept\.com$ [NC]
  RewriteRule ^fabbrica/?$ https://artefice.rucept.com/ [L,R=301]
  # Clean URLs for legal pages
  RewriteRule ^privacy-policy/?$ privacy-policy.html [L]
  RewriteRule ^terms-of-service/?$ terms-of-service.html [L]
  RewriteRule ^fabbrica/?$ fabbrica.html [L]
  RewriteRule ^invite/?$ /invite.html [L,R=301]
  # Serve the Artefice landing page on artefice.rucept.com (canonical) and artifice.rucept.com (alias)
  RewriteCond %{HTTP_HOST} ^(artefice|artifice)\.rucept\.com$ [NC]
  RewriteRule ^$ fabbrica.html [L]
  # php -- BEGIN cPanel-generated handler, do not edit
  # Set the "ea-php81" package as the default "PHP" programming language.
  <IfModule mime_module>
  AddHandler application/x-httpd-ea-php81 .php .php8 .phtml
  # php -- END cPanel-generated handler, do not edit

# Fix stale page caching: browsers must revalidate HTML with the server on every visit
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
